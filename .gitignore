# Abhängigkeiten & Build
node_modules/
.next/
out/
# Kopie der Daten für die statische Online-Version (wird von npm run build:pages erzeugt)
public/daten/
*.tsbuildinfo
next-env.d.ts

# Geheimnisse: API-Keys, Passwörter und Zertifikate gehören NIE ins Repo
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
.npmrc
.claude/settings.local.json

# Rohdownloads (die entpackten Quell-XML-Dateien werden versioniert)
data/quellen/**/*.zip
# PDF-Quellen (MBO, VOB) – versioniert wird nur der daraus gelesene Text
data/quellen/**/*.pdf
# NI-VORIS (Wolters Kluwer) behält sich Text- und Data-Mining vor (§ 44b Abs. 3 UrhG).
# Der Gesetzestext selbst ist gemeinfrei (§ 5 UrhG) und liegt in data/gesetze/ndschg.json –
# die Roh-HTML-Seiten mit Verlags-Markup veröffentlichen wir nicht.
data/quellen/ndschg/
data/quellen/nbauo/
# Rohdaten der Landesrechtsportale (nur der gemeinfreie Gesetzestext wird veröffentlicht, in data/gesetze/)
data/quellen/landesrecht/

# Obsidian-Vault: wird lokal mit „npm run obsidian“ aus data/ und dem Code erzeugt (rund 1.700 Notizen) –
# nicht versionieren, sonst ändert jede Neuerzeugung Hunderte Dateien
obsidian/

# System
.DS_Store
Thumbs.db
